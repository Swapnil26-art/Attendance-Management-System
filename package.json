{
  "name": "attendance-management-system",
  "version": "1.0.0",
  "description": "Mini Attendance Management System - full stack (React + Node/Express + MySQL) deployable on Vercel",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix client install",
    "dev:server": "npm --prefix backend run dev",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "start": "node backend/server.js",
    "seed": "npm --prefix backend run seed"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-validator": "^7.2.0",
    "json2csv": "^5.0.7",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  }
}