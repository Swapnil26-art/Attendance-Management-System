# =============================================
# Attendance Management System - Environment Template
# Copy this file to ".env" and fill in real values.
# On Vercel, set these as Environment Variables instead.
# =============================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (MySQL) ---
# Local MySQL (XAMPP):   host=127.0.0.1  port=3306  DB_SSL=false
# TiDB Cloud serverless: host=xxxx.aws.tidbcloud.com  port=4000  DB_SSL=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=attendance_db
DB_SSL=false

# --- JWT ---
JWT_SECRET=replace-with-a-long-random-secret-string
JWT_EXPIRES_IN=24h